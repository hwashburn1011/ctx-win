# Copy to `.env` and fill in. Loaded automatically via python-dotenv.
#
# ai-daily needs NO credentials by default. The LLM backend is the local
# Claude Code CLI (`claude -p`), configured in config/llm.yaml -- it uses your
# existing Claude Code login, no API key.
#
# The variables below are only needed if you switch config/llm.yaml's
# `backend:` to "anthropic-sdk".

# Anthropic API key (only for the anthropic-sdk backend).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the LLM backend without editing config/llm.yaml.
# AI_DAILY_LLM_BACKEND=claude-cli
